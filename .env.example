# ---- Server
NODE_ENV=development
PORT=3000
# Required: long random string. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
# Optional: comma-separated origins allowed for cross-origin API calls (leave empty when the frontend is served by this app)
CORS_ORIGIN=
# The address people use to open the app. Used for links inside emails.
APP_URL=http://localhost:3000
# Shown at the top of PDF report cards and receipts
SCHOOL_NAME=My School

# ---- Database
# SQLite is the single active database engine. Leave DB_DRIVER unset (defaults to sqlite).
# DB_DRIVER=mysql            # only for local MySQL testing; not used in production
# Render persistent disk path. Mount a disk at /var/data and set this so data survives restarts.
SQLITE_DB_PATH=/var/data/school_erp.sqlite
# Local dev override (defaults to backend/data/school-erp.sqlite)
SQLITE_PATH=
# Production notification cleanup is disabled unless explicitly enabled.
NOTIFICATION_CLEANUP_ENABLED=false

# ---- First admin account (created once by `npm run db:seed`)
ADMIN_NAME=School Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# ---- Email (optional). Leave SMTP_HOST empty to keep email off; everything else still works.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---- Optional
# Where uploaded files are stored (default: backend/uploads)
UPLOAD_DIR=